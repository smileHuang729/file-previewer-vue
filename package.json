{
  "name": "pdf-screenshot",
  "version": "0.1.0",
  "main": "file-previewer/file-previewer.umd.min.js",
  "private": false,
  "author": "smileHuang729",
  "description": "针对不同类型文件的统一预览",
  "keywords": [
    "vue",
    "screenshot",
    "pdf-screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/smileHuang729/file-previewer.git"
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "lib": "vue-cli-service build --target lib --name file-previewer --dest file-previewer packages/index.js"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "pdfjs-dist": "^2.0.943",
    "sass": "^1.80.6",
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "css-loader": "^2.1.1",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vue-template-compiler": "^2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
